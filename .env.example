# ==============================================================
# EVENTIFY — ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env.local for local testing.
# In Vercel, set these in Project Settings -> Environment Variables.
# NEVER commit real production keys to version control.
# ==============================================================

# 1. Supabase Cloud Database & Storage (https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANT: Service Role Key bypasses RLS and is used exclusively by server-side API functions.
# NEVER expose this key to client-side code or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. JWT Cryptographic Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-32-byte-hex-string

# 3. Transactional Email Provider (Required for production password resets)
# Resend API Key (https://resend.com - Free tier: 3,000 emails/mo)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Eventify <notifications@your-domain.com>

# 4. Environment Mode
NODE_ENV=development
